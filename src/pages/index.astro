---
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/components.css";
import "../styles/layout.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/jetbrains-mono/400.css";

import { site } from "../data/site";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{site.name} — software & silicon</title>
    <meta
      name="description"
      content="Electrical engineering and computer science at Purdue, working across hardware and software."
    />
    <meta property="og:title" content={`${site.name} — software & silicon`} />
    <meta
      property="og:description"
      content="Electrical engineering and computer science at Purdue, working across hardware and software."
    />
    <meta property="og:type" content="website" />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <Hero />

      <section class="band band--alt" data-reveal>
        <div class="inner">
          <ul class="stats">
            {
              site.stats.map((s) => (
                <li class="stat">
                  <span class="stat__value">{s.value}</span>
                  <span class="stat__label">{s.label}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section id="work" class="band" data-reveal>
        <div class="inner">
          <p class="eyebrow">selected work</p>
          <h2 class="section__title">Selected work</h2>
        </div>
        <!-- Auto-scrolling marquee (owner-approved spec exception — see CLAUDE.md).
             The set is rendered twice so translateX(-50%) loops seamlessly; the
             second copy is hidden from assistive tech + keyboard. -->
        <div class="marquee" data-marquee>
          <ul class="marquee__track">
            {site.projects.map((project) => (
              <li class="marquee__item">
                <ProjectCard project={project} />
              </li>
            ))}
            {site.projects.map((project) => (
              <li class="marquee__item" aria-hidden="true">
                <ProjectCard project={project} clone />
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section id="about" class="band band--alt" data-reveal>
        <div class="inner cols">
          <div class="rail">
            <p class="eyebrow">about</p>
            <h2 class="rail__title">About</h2>
          </div>
          <div class="about">
            <p class="about__body">{site.about}</p>
          </div>
        </div>
      </section>

      <section id="skills" class="band" data-reveal>
        <div class="inner cols">
          <div class="rail">
            <p class="eyebrow">skills</p>
            <h2 class="rail__title">Skills</h2>
          </div>
          <dl class="skills">
            {
              site.skills.map((group) => (
                <div class="skill-group">
                  <dt>{group.group}</dt>
                  <dd>
                    <ul class="skills__items">
                      {group.items.map((item) => (
                        <li class="tag">{item}</li>
                      ))}
                    </ul>
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>
    </main>

    <Footer />

    <script>
      import "../scripts/enhance.ts";
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        padding: var(--sp-2) var(--sp-4);
        background: var(--surface);
        border: var(--hairline) solid var(--border-strong);
        border-radius: var(--radius);
        z-index: 20;
      }
      .skip-link:focus {
        left: var(--sp-4);
        top: var(--sp-4);
      }

      /* Stats strip */
      .stats {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
        gap: var(--sp-8);
      }
      .stat {
        display: flex;
        flex-direction: column;
        gap: var(--sp-1);
      }
      .stat__value {
        font-size: var(--fs-display);
        font-weight: 500;
        line-height: 1;
        color: var(--accent);
      }
      .stat__label {
        font-size: var(--fs-caption);
        color: var(--text-secondary);
      }

      /* Work */
      .section__title {
        font-size: var(--fs-h1);
        margin-top: var(--sp-2);
      }
      .work-grid {
        margin-top: var(--sp-8);
      }

      /* About */
      .about__body {
        font-size: var(--fs-lead);
        color: var(--text-secondary);
        max-width: 46rem;
      }

      /* Skills */
      .skills {
        display: grid;
        gap: var(--sp-6);
        margin: 0;
      }
      .skill-group {
        display: grid;
        grid-template-columns: 9rem 1fr;
        gap: var(--sp-4);
        align-items: start;
      }
      .skill-group dt {
        color: var(--text-secondary);
        font-size: var(--fs-caption);
      }
      .skill-group dd {
        margin: 0;
      }
      .skills__items {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: var(--sp-2);
        padding: 0;
      }
      @media (max-width: 36rem) {
        .skill-group {
          grid-template-columns: 1fr;
          gap: var(--sp-2);
        }
      }
    </style>
  </body>
</html>
