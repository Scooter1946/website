---
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/components.css";
import "../styles/layout.css";
import "@fontsource-variable/space-grotesk";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/jetbrains-mono/400.css";

import { site } from "../data/site";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Experience from "../components/Experience.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Footer from "../components/Footer.astro";

const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  jobTitle: "Software & electrical engineer",
  alumniOf: { "@type": "CollegeOrUniversity", name: "Purdue University" },
  sameAs: site.links.map((l) => l.href),
  knowsAbout: ["Firmware", "FPGAs", "Machine learning", "Web development", "Competitive programming"],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{site.name} — software & silicon</title>
    <meta name="description" content={site.tagline} />
    <meta property="og:title" content={`${site.name} — software & silicon`} />
    <meta property="og:description" content={site.tagline} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <Hero />

      <!-- Keyword ticker — the always-on scroll (owner-approved motion
           exception; see CLAUDE.md). Decorative, hidden from AT. -->
      <div class="ticker" data-marquee aria-hidden="true">
        <ul class="ticker__track">
          {
            site.keywords.map((k) => (
              <li class="ticker__item">
                {k}
                <span class="ticker__sep">◆</span>
              </li>
            ))
          }
          {
            site.keywords.map((k) => (
              <li class="ticker__item">
                {k}
                <span class="ticker__sep">◆</span>
              </li>
            ))
          }
        </ul>
      </div>

      <section class="band band--tint" aria-label="By the numbers">
        <div class="inner inner--tight">
          <ul class="stats">
            {
              site.stats.map((s, i) => (
                <li class="stat" data-reveal="scale" style={`--i:${i}`}>
                  {s.href ? (
                    <a
                      class="stat__body stat__body--link"
                      href={s.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${s.value} — ${s.label} (opens the source in a new tab)`}
                    >
                      <span class="stat__value">{s.value}</span>
                      <span class="stat__label">
                        {s.label}
                        <span class="stat__ext" aria-hidden="true">↗</span>
                      </span>
                    </a>
                  ) : (
                    <div class="stat__body">
                      <span class="stat__value">{s.value}</span>
                      <span class="stat__label">{s.label}</span>
                    </div>
                  )}
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <Experience />

      <section id="work" class="band band--alt">
        <div class="inner">
          <div class="section-head" data-reveal>
            <div class="section-head__eyebrow">
              <span class="section-head__index">02 / selected work</span>
              <span class="section-head__line" aria-hidden="true"></span>
            </div>
            <h2 class="section-head__title">Things I've <em>built</em>.</h2>
          </div>
          <div class="bento">
            {
              site.projects.map((project, i) => (
                <div
                  class={`bento__item${i === 0 ? " bento__item--featured" : ""}`}
                  data-reveal="scale"
                  style={`--i:${i}`}
                >
                  <ProjectCard project={project} index={i} />
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section id="about" class="band band--dark" data-spotlight>
        <div class="inner">
          <h2 class="visually-hidden">About</h2>
          <div class="section-head" data-reveal>
            <div class="section-head__eyebrow">
              <span class="section-head__index">03 / about</span>
              <span class="section-head__line" aria-hidden="true"></span>
            </div>
          </div>
          <blockquote class="quote" data-reveal style="--i:0" set:html={site.aboutQuote.replace(
            "top to bottom",
            "<em>top to bottom</em>"
          )} />
          <p class="about__body" data-reveal style="--i:1">{site.about}</p>
          <div class="about-meta" data-reveal style="--i:2">
            <div class="about-meta__item">
              <span class="about-meta__k">studying</span>
              <span class="about-meta__v">{site.education} · {site.gradYear}</span>
            </div>
            <div class="about-meta__item">
              <span class="about-meta__k">currently</span>
              <span class="about-meta__v">SWE intern @ Vivalink · Quant @ Boiler Quant</span>
            </div>
            <div class="about-meta__item">
              <span class="about-meta__k">also</span>
              <span class="about-meta__v">AIME qualifier · Codeforces Expert</span>
            </div>
          </div>
        </div>
      </section>

      <section id="skills" class="band">
        <div class="inner cols">
          <div class="rail" data-reveal>
            <p class="eyebrow">04 / skills</p>
            <h2 class="rail__title">Toolbox.</h2>
          </div>
          <dl class="skills">
            {
              site.skills.map((group) => (
                <div class="skill-group">
                  <dt data-reveal>{group.group}</dt>
                  <dd>
                    <ul class="skills__items">
                      {group.items.map((item, j) => (
                        <li class="tag" data-reveal style={`--i:${j}`}>
                          {item}
                        </li>
                      ))}
                    </ul>
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>
    </main>

    <Footer />

    <script>
      import "../scripts/enhance.ts";
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        padding: var(--sp-2) var(--sp-4);
        background: var(--surface);
        border: var(--hairline) solid var(--border-strong);
        border-radius: var(--radius);
        z-index: 80;
      }
      .skip-link:focus {
        left: var(--sp-4);
        top: var(--sp-4);
      }

      .about__body {
        font-size: var(--fs-lead);
        color: var(--dark-text-secondary);
        max-width: var(--maxw-text);
        margin-top: var(--sp-8);
      }
    </style>
  </body>
</html>
