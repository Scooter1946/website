---
import { skills } from "../data/site";
---

<section id="skills" class="bg-paper py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <p class="reveal mb-10 font-mono text-[12px] tracking-wide text-graphite">stack</p>
    <div class="grid gap-y-8 md:grid-cols-[1fr_1.4fr] md:gap-16">
      <h2 class="reveal text-[26px] font-medium leading-tight">What I work with</h2>
      <div class="reveal space-y-6">
        {
          skills.map((g) => (
            <div class="grid grid-cols-[84px_1fr] items-baseline gap-4">
              <span class="font-mono text-[12px] text-graphite">{g.group}</span>
              <ul class="flex flex-wrap gap-2">
                {g.items.map((s) => (
                  <li class="rounded border border-ink/15 px-2.5 py-1 font-mono text-[12px] text-ink/75">
                    {s}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
