---
import { projects } from "../data/site";
---

<section id="work" class="bg-paper pb-12 sm:pb-16">
  <div class="mx-auto max-w-6xl px-6">
    <p class="reveal mb-10 font-mono text-[12px] tracking-wide text-graphite">selected work</p>
    <div class="grid gap-10 md:grid-cols-[1fr_1.4fr] md:gap-16">
      <h2 class="reveal text-[26px] font-medium leading-tight">Things I've built</h2>
      <p class="reveal max-w-prose text-[18px] leading-relaxed text-ink/80">
        All personal projects — built to learn something new, take to a hackathon, or just see if I
        could pull it off.
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-6">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((p) => (
          <article class="reveal group flex flex-col rounded-lg border border-ink/12 bg-paper-2/40 p-5 transition-colors hover:border-copper/50">
            <span class="font-mono text-[11px] text-copper">[{p.layer}]</span>
            <h3 class="mt-2 font-display text-[18px] font-medium">{p.name}</h3>
            <p class="mt-2 flex-1 text-[15px] leading-relaxed text-ink/75">{p.blurb}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {p.stack.map((s) => (
                <li class="font-mono text-[11px] text-graphite">{s}</li>
              ))}
            </ul>
            <div class="mt-4 flex gap-4 font-mono text-[12px]">
              {
                p.code && (
                  <a href={p.code} class="text-graphite transition-colors hover:text-copper">
                    code ↗
                  </a>
                )
              }
              {
                p.live && (
                  <a href={p.live} class="text-graphite transition-colors hover:text-copper">
                    live ↗
                  </a>
                )
              }
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
