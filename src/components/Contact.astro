---
import { profile } from "../data/site";
---

<section id="contact" class="bg-ink py-28 text-paper sm:py-36">
  <div class="mx-auto max-w-6xl px-6 text-center">
    <h2 class="reveal text-[clamp(1.6rem,4vw,2.6rem)] font-medium leading-tight">
      Let's build something together.
    </h2>
    <p class="reveal mx-auto mt-5 max-w-md text-[17px] leading-relaxed text-paper/70">
      I'm after software engineering internships — and I'm always happy to just chat. Email's the
      fastest way to reach me.
    </p>
    <div class="reveal mt-9 flex flex-wrap items-center justify-center gap-4 font-mono text-[13px]">
      <a
        href={`mailto:${profile.email}`}
        class="inline-flex items-center gap-2 rounded-md bg-copper px-5 py-2.5 text-paper transition-colors hover:bg-copper-bright"
        >Email me →</a
      >
      <a href={profile.github} class="text-paper/70 transition-colors hover:text-paper">github ↗</a>
      <a href={profile.linkedin} class="text-paper/70 transition-colors hover:text-paper"
        >linkedin ↗</a
      >
    </div>
    <p class="reveal mt-5 font-mono text-[12px] text-paper/50">
      or call / text ·
      <a
        href={`tel:${profile.phone}`}
        class="text-paper/70 underline-offset-4 transition-colors hover:text-paper hover:underline"
        >{profile.phone}</a
      >
    </p>
  </div>
  <footer class="mx-auto mt-20 max-w-6xl px-6">
    <div
      class="flex flex-wrap items-center justify-between gap-2 border-t border-paper/10 pt-6 font-mono text-[11px] text-paper/40"
    >
      <span>© 2026 {profile.name}</span>
      <span>built with astro · tailwind · gsap</span>
    </div>
  </footer>
</section>
