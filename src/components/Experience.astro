---
import { experience } from "../data/site";
---

<section id="experience" class="bg-paper pb-24 sm:pb-32">
  <div class="mx-auto max-w-6xl px-6">
    <p class="reveal mb-10 font-mono text-[12px] tracking-wide text-graphite">2022 — present</p>
    <div class="grid gap-10 md:grid-cols-[1fr_1.4fr] md:gap-16">
      <h2 class="reveal text-[26px] font-medium leading-tight">Where I've worked</h2>
      <ol class="relative border-l border-ink/15">
        {
          experience.map((job) => (
            <li class="reveal relative mb-10 pl-7 last:mb-0">
              <span class="absolute -left-[5px] top-2 h-2.5 w-2.5 rounded-full bg-copper" />
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h3 class="text-[18px] font-medium">
                  {job.role} <span class="text-graphite">· {job.org}</span>
                </h3>
                <span class="font-mono text-[12px] text-graphite-2">{job.period}</span>
              </div>
              <p class="mt-1.5 max-w-prose text-ink/75">{job.blurb}</p>
              <ul class="mt-3 flex flex-wrap gap-2">
                {job.stack.map((s) => (
                  <li class="rounded border border-ink/15 px-2 py-0.5 font-mono text-[11px] text-graphite">
                    {s}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
