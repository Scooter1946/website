---
import { site } from "../data/site";
import StatusPill from "./StatusPill.astro";

const words = JSON.stringify(site.specializations);
---

<header class="hero" id="top">
  <p class="eyebrow" data-rise="0">software &amp; silicon</p>
  <h1 class="hero__title" data-rise="1">{site.name}</h1>
  <p class="hero__lead" data-rise="2">
    Electrical engineering and computer science — currently focused on
    <span class="kinetic-slot">
      <span class="kinetic" data-kinetic data-words={words}>{site.specializations[0]}</span>
    </span>
  </p>
  <div class="hero__status" data-rise="3">
    <StatusPill />
  </div>
  <div class="hero__cta" data-rise="4">
    <a class="btn btn--primary" href={`mailto:${site.email}`}>Get in touch</a>
    <a class="btn" href={site.resume}>Résumé</a>
  </div>
</header>

<style>
  .hero {
    max-width: 56rem;
    margin-inline: auto;
    padding: var(--sp-24) var(--sp-6) var(--sp-16);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-4);
  }
  .hero__title {
    font-size: var(--fs-display);
  }
  .hero__lead {
    font-size: var(--fs-lead);
    color: var(--text-secondary);
    max-width: 40rem;
  }
  /* Reserve width so the cycling word never shifts layout (CLS ~ 0). */
  .kinetic-slot {
    display: inline-block;
    min-width: 6em;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-2);
  }
</style>
