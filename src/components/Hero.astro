---
import { site } from "../data/site";
import StatusPill from "./StatusPill.astro";

const words = JSON.stringify(site.specializations);
---

<header class="band hero" id="top">
  <div class="aurora" aria-hidden="true" data-parallax="0.12">
    <span class="aurora__blob aurora__blob--1"></span>
    <span class="aurora__blob aurora__blob--2"></span>
    <span class="aurora__blob aurora__blob--3"></span>
  </div>

  <div class="inner hero__inner">
    <div class="hero__top" data-rise="0">
      <p class="eyebrow">software &amp; silicon</p>
      <StatusPill />
    </div>

    <h1 class="hero__name" data-rise="1">Justin <em>Chen</em></h1>

    <div class="hero__row">
      <div class="hero__intro">
        <p class="hero__lead" data-rise="2">
          Electrical engineering &amp; computer science at Purdue — currently building
          <span class="kinetic-slot"
            ><span class="kinetic" data-kinetic data-words={words}
              >{site.specializations[0]}</span
            ></span
          >
        </p>
        <div class="hero__cta" data-rise="3">
          <a class="btn btn--primary" href={`mailto:${site.email}`} data-magnet>Get in touch</a>
          <a class="btn" href="#work">See my work</a>
        </div>
      </div>

      <aside class="hero__panel" data-rise="4">
        <div class="pad" data-spotlight data-tilt="16">
          <div class="pad__shadow" aria-hidden="true"></div>
          <div class="pad__stage">
            <div class="pad__face pad__face--bottom" aria-hidden="true"></div>
            <div class="pad__face pad__face--back" aria-hidden="true"></div>
            <div class="pad__face pad__face--left" aria-hidden="true"></div>
            <div class="pad__face pad__face--right" aria-hidden="true"></div>
            <div class="pad__face pad__face--front" aria-hidden="true">
              <span class="port"></span>
            </div>
            <div class="pad__face pad__face--top">
              <div class="hinge" aria-hidden="true">
                <span class="hinge__knuckle"></span>
                <span class="hinge__knuckle"></span>
                <span class="hinge__knuckle"></span>
              </div>
              <div
                class="pad__keys"
                role="group"
                aria-label="Macropad — a nod to the keypad I built. Press a key."
              >
                {
                  Array.from({ length: 25 }).map((_, i) => (
                    <button type="button" class="key" data-key aria-label={`Key ${i + 1}`}>
                      <span class="key__wall key__wall--front" aria-hidden="true" />
                      <span class="key__wall key__wall--left" aria-hidden="true" />
                      <span class="key__wall key__wall--right" aria-hidden="true" />
                    </button>
                  ))
                }
              </div>
              <span class="screw screw--tl" aria-hidden="true"></span>
              <span class="screw screw--tr" aria-hidden="true"></span>
              <span class="screw screw--bl" aria-hidden="true"></span>
              <span class="screw screw--br" aria-hidden="true"></span>
              <span class="pad__label" aria-hidden="true">macropad</span>
              <div class="pad__glow" aria-hidden="true"></div>
            </div>
          </div>
        </div>
      </aside>
    </div>

    <dl class="facts" data-rise="5">
      <div class="fact">
        <dt>Based in</dt>
        <dd>{site.location}</dd>
      </div>
      <div class="fact">
        <dt>Studying</dt>
        <dd>{site.education}</dd>
      </div>
      <div class="fact">
        <dt>Focus</dt>
        <dd>{site.specializations.join(" · ")}</dd>
      </div>
      <div class="fact">
        <dt>Find me</dt>
        <dd class="facts__links">
          {site.links.map((l) => <a href={l.href}>{l.label}</a>)}
        </dd>
      </div>
    </dl>
  </div>
</header>

<style>
  .hero {
    overflow: clip; /* keep the aurora + parallax off the next section */
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: clamp(var(--sp-4), 2vw, var(--sp-8));
    padding-top: clamp(var(--sp-10), 5vw, var(--sp-16));
    padding-bottom: clamp(var(--sp-8), 3.5vw, var(--sp-12));
  }
  .hero__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }
  .hero__name {
    font-size: var(--fs-hero);
    font-weight: var(--fw-light);
    letter-spacing: -0.04em;
    line-height: 0.92;
  }
  .hero__name em {
    font-style: normal;
    font-weight: var(--fw-semibold);
    color: var(--accent);
  }
  .hero__row {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(var(--sp-8), 4vw, var(--sp-16));
    align-items: center;
  }
  .hero__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-4);
  }
  .hero__lead {
    font-size: var(--fs-lead);
    color: var(--text-secondary);
    max-width: 34rem;
  }
  /* The cycling word ends the sentence, so its changing width shifts
     nothing after it — no reserved min-width needed. */
  .kinetic-slot {
    display: inline-block;
    white-space: nowrap;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }
  .hero__panel {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--sp-4) var(--sp-8);
    margin: 0;
    padding-top: clamp(var(--sp-4), 2vw, var(--sp-6));
    border-top: var(--hairline) solid var(--border);
  }
  .fact dt {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    letter-spacing: 0.5px;
    color: var(--text-tertiary);
    margin-bottom: var(--sp-1);
  }
  .fact dd {
    margin: 0;
    font-size: var(--fs-caption);
    color: var(--text-primary);
  }
  .facts__links {
    display: flex;
    gap: var(--sp-4);
  }
  .facts__links a { color: var(--accent); }

  @media (max-width: 52rem) {
    .hero__row {
      grid-template-columns: 1fr;
      gap: var(--sp-10);
    }
    .hero__panel { order: -1; } /* macropad leads on mobile */
  }
</style>
