---
import { site } from "../data/site";
import StatusPill from "./StatusPill.astro";

const words = JSON.stringify(site.specializations);
---

<header class="band hero" id="top">
  <div class="inner hero__grid">
    <div class="hero__main">
      <p class="eyebrow" data-rise="0">software &amp; silicon</p>
      <h1 class="hero__title" data-rise="1">{site.name}</h1>
      <p class="hero__lead" data-rise="2">
        Electrical engineering and computer science — currently focused on
        <span class="kinetic-slot"
          ><span class="kinetic" data-kinetic data-words={words}>{site.specializations[0]}</span></span
        >
      </p>
      <div class="hero__cta" data-rise="3">
        <a class="btn btn--primary" href={`mailto:${site.email}`}>Get in touch</a>
        <a class="btn" href={site.resume}>Résumé</a>
      </div>
      <dl class="facts" data-rise="4">
        <div class="fact">
          <dt>Based in</dt>
          <dd>{site.location}</dd>
        </div>
        <div class="fact">
          <dt>Studying</dt>
          <dd>{site.education}</dd>
        </div>
        <div class="fact">
          <dt>Focus</dt>
          <dd>{site.specializations.join(" · ")}</dd>
        </div>
        <div class="fact">
          <dt>Find me</dt>
          <dd class="facts__links">
            {site.links.map((l) => <a href={l.href}>{l.label}</a>)}
          </dd>
        </div>
      </dl>
    </div>

    <aside class="hero__panel" data-rise="5">
      <StatusPill />
      <div class="pad" data-spotlight data-tilt="16">
        <div class="pad__shadow" aria-hidden="true"></div>
        <div class="pad__stage">
          <div class="pad__face pad__face--bottom" aria-hidden="true"></div>
          <div class="pad__face pad__face--back" aria-hidden="true"></div>
          <div class="pad__face pad__face--left" aria-hidden="true"></div>
          <div class="pad__face pad__face--right" aria-hidden="true"></div>
          <div class="pad__face pad__face--front" aria-hidden="true">
            <span class="port"></span>
          </div>
          <div class="pad__face pad__face--top">
            <div class="hinge" aria-hidden="true">
              <span class="hinge__knuckle"></span>
              <span class="hinge__knuckle"></span>
              <span class="hinge__knuckle"></span>
            </div>
            <div
              class="pad__keys"
              role="group"
              aria-label="Macropad — a nod to the keypad I built. Press a key."
            >
              {
                Array.from({ length: 30 }).map((_, i) => (
                  <button type="button" class="key" data-key aria-label={`Key ${i + 1}`}>
                    <span class="key__wall key__wall--front" aria-hidden="true" />
                    <span class="key__wall key__wall--left" aria-hidden="true" />
                    <span class="key__wall key__wall--right" aria-hidden="true" />
                  </button>
                ))
              }
            </div>
            <span class="screw screw--tl" aria-hidden="true"></span>
            <span class="screw screw--tr" aria-hidden="true"></span>
            <span class="screw screw--bl" aria-hidden="true"></span>
            <span class="screw screw--br" aria-hidden="true"></span>
            <span class="pad__label" aria-hidden="true">macropad</span>
            <div class="pad__glow" aria-hidden="true"></div>
          </div>
        </div>
      </div>
    </aside>
  </div>
</header>

<style>
  .hero .inner {
    padding-top: var(--sp-16);
    padding-bottom: var(--sp-16);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--sp-12);
    align-items: start;
  }
  .hero__main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-4);
  }
  .hero__title {
    font-size: var(--fs-display);
  }
  .hero__lead {
    font-size: var(--fs-lead);
    color: var(--text-secondary);
    max-width: 36rem;
  }
  /* Reserve width so the cycling word never shifts layout (CLS ~ 0). */
  .kinetic-slot {
    display: inline-block;
    min-width: 6em;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-2);
  }
  /* Warm "clay" pedestal — a deeper peach than the cream surface so the light
     macropad separates and the right side carries weight, while staying on the
     warm/light theme. One accent only (tinted into the surface). */
  .hero__panel {
    border: var(--hairline) solid color-mix(in srgb, var(--accent) 30%, var(--border-strong));
    border-radius: var(--radius-card);
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--accent) 18%, var(--surface)),
      color-mix(in srgb, var(--accent) 30%, var(--surface))
    );
    padding: var(--sp-6);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--sp-4) var(--sp-8);
    width: 100%;
    max-width: 32rem;
    margin: var(--sp-4) 0 0;
  }
  .fact dt {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    letter-spacing: 0.5px;
    color: var(--text-tertiary);
  }
  .fact dd {
    margin: 0;
    font-size: var(--fs-caption);
    color: var(--text-primary);
  }
  .facts__links {
    display: flex;
    gap: var(--sp-3);
  }
  .facts__links a {
    color: var(--accent);
  }
  @media (max-width: 48rem) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: var(--sp-8);
    }
    .hero .inner {
      padding-top: var(--sp-16);
    }
  }
</style>
