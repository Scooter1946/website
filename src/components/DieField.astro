---
// Abstract silicon-die floorplan behind the hero — flat shapes, no gradients.
const blocks = [
  { x: 60, y: 70, w: 210, h: 150, label: "fetch" },
  { x: 290, y: 70, w: 150, h: 150, label: "decode" },
  { x: 60, y: 240, w: 150, h: 170, label: "regfile" },
  { x: 230, y: 240, w: 210, h: 170, label: "alu" },
  { x: 470, y: 70, w: 270, h: 200, label: "l1 cache" },
  { x: 470, y: 290, w: 270, h: 120, label: "l2 cache" },
];
---

<div class="pointer-events-none absolute inset-0 overflow-hidden opacity-[0.4]" aria-hidden="true">
  <svg
    class="die h-full w-full"
    viewBox="0 0 800 480"
    preserveAspectRatio="xMidYMid slice"
    fill="none"
  >
    <rect x="20" y="20" width="760" height="440" rx="8" stroke="var(--color-graphite)" stroke-width="1" opacity="0.5" />
    {
      blocks.map((b) => (
        <g>
          <rect
            x={b.x}
            y={b.y}
            width={b.w}
            height={b.h}
            rx="4"
            stroke="var(--color-copper)"
            stroke-width="1"
            opacity="0.55"
          />
          <text
            x={b.x + 10}
            y={b.y + 22}
            fill="var(--color-copper-bright)"
            opacity="0.7"
            style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.04em;"
          >
            {b.label}
          </text>
        </g>
      ))
    }
    <path class="trace" d="M270 145 H290 M440 155 H470 M210 320 H230 M440 330 H560 V270" stroke="var(--color-violet)" stroke-width="1.5" opacity="0.7" />
    <path class="trace trace-2" d="M605 270 V145 M335 220 V240" stroke="var(--color-teal)" stroke-width="1.5" opacity="0.7" />
    <g fill="var(--color-copper)" opacity="0.5">
      <rect x="20" y="120" width="6" height="14" /><rect x="20" y="160" width="6" height="14" /><rect x="20" y="200" width="6" height="14" />
      <rect x="774" y="120" width="6" height="14" /><rect x="774" y="160" width="6" height="14" /><rect x="774" y="200" width="6" height="14" />
    </g>
  </svg>
</div>

<style>
  .trace {
    stroke-dasharray: 8 10;
  }
  @media (prefers-reduced-motion: no-preference) {
    .trace {
      animation: flow 2.6s linear infinite;
    }
    .trace-2 {
      animation-duration: 3.4s;
    }
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -36;
    }
  }
</style>
