---
import { gallery } from "../data/site";
---

<section id="travels" class="bg-paper pb-24 sm:pb-32">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal mb-8 flex items-end justify-between gap-4">
      <div>
        <p class="mb-2 font-mono text-[12px] tracking-wide text-graphite">through my lens</p>
        <h2 class="text-[26px] font-medium leading-tight">Shots from the road</h2>
      </div>
      <div class="hidden gap-2 sm:flex">
        <button id="gal-prev" aria-label="Scroll left" class="gal-btn">←</button>
        <button id="gal-next" aria-label="Scroll right" class="gal-btn">→</button>
      </div>
    </div>
    <div id="gal" class="reveal flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4">
      {
        gallery.map((g) => (
          <figure class="snap-start shrink-0">
            <div class="h-[280px] w-[360px] overflow-hidden rounded-2xl border border-ink/10 bg-paper-2">
              <img
                src={g.src}
                alt={g.caption}
                width="600"
                height="440"
                loading="lazy"
                class="h-full w-full object-cover"
              />
            </div>
            <figcaption class="mt-2.5 font-mono text-[12px] text-graphite">{g.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  #gal {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  #gal::-webkit-scrollbar {
    display: none;
  }
  .gal-btn {
    width: 38px;
    height: 38px;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 22%, transparent);
    color: var(--color-ink);
    font-size: 16px;
    transition: all 0.2s;
  }
  .gal-btn:hover {
    background: var(--color-copper);
    border-color: var(--color-copper);
    color: var(--color-paper);
  }
</style>

<script>
  const gal = document.getElementById("gal");
  const amt = 380;
  document
    .getElementById("gal-prev")
    ?.addEventListener("click", () => gal?.scrollBy({ left: -amt, behavior: "smooth" }));
  document
    .getElementById("gal-next")
    ?.addEventListener("click", () => gal?.scrollBy({ left: amt, behavior: "smooth" }));
</script>
