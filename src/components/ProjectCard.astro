---
import type { Project } from "../data/site";

const { project, index = 0 } = Astro.props as { project: Project; index?: number };
const num = String(index + 1).padStart(2, "0");
---

<a class="card" href={project.href} target="_blank" rel="noopener noreferrer" data-tilt data-spotlight>
  <div class="card__meta">
    <span class="card__index">{num}</span>
    {project.period && <span class="card__period">{project.period}</span>}
  </div>
  <div class="card__head">
    <h3 class="card__title">{project.title}</h3>
    <span class="card__arrow" aria-hidden="true">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="7" y1="17" x2="17" y2="7"></line>
        <polyline points="8 7 17 7 17 16"></polyline>
      </svg>
    </span>
  </div>
  {project.badge && <span class="card__badge">{project.badge}</span>}
  <p class="card__outcome">{project.outcome}</p>
  <ul class="card__tags">
    {project.tags.map((t) => <li class="tag">{t}</li>)}
  </ul>
</a>

<style>
  .card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
  }
  .card__period {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--text-tertiary);
  }
</style>
