---
import { profile, accolades, education } from "../data/site";
---

<section id="about" class="bg-paper pt-20 pb-12 sm:pt-28">
  <div class="mx-auto max-w-6xl px-6">
    <p class="reveal mb-10 font-mono text-[12px] tracking-wide text-graphite">
      currently · {profile.location}
    </p>
    <div class="grid gap-8 md:grid-cols-[1fr_1.4fr] md:gap-16">
      <div class="reveal">
        <h2 class="text-[26px] font-medium leading-tight">A bit about me</h2>
        <div class="mt-8 border-l-2 border-copper/30 pl-4">
          <p class="font-mono text-[11px] uppercase tracking-wide text-copper">Education</p>
          <p class="mt-2 text-[15px] font-medium text-ink/90">{education.school}</p>
          <p class="text-[14px] text-ink/70">{education.degree}</p>
          <p class="text-[13px] text-ink/60">{education.minors}</p>
          <p class="mt-1.5 font-mono text-[12px] text-graphite">
            {education.period} · {education.gpa}
          </p>
        </div>
      </div>
      <div class="reveal space-y-5">
        <p class="text-[clamp(1.05rem,1.6vw,1.3rem)] leading-relaxed text-ink/85">{profile.blurb}</p>
        <p class="font-mono text-[13px] text-graphite">also · {accolades.join(" · ")}</p>
      </div>
    </div>
  </div>
</section>
